# kite-connect-mcp configuration. Copy to .env (mode 600) or put these in a systemd EnvironmentFile.
# Never commit a filled-in copy. Every value below shows its default unless marked "example".

# --- Kite Connect app (https://developers.kite.trade) ----------------------------------------------------------
# Each secret can be given directly or as NAME_FILE=/path (a file with mode 600 holding only the value).
KITE_API_KEY=
# KITE_API_KEY_FILE=/etc/kite-connect-mcp/api_key
KITE_API_SECRET=
# KITE_API_SECRET_FILE=/etc/kite-connect-mcp/api_secret

# --- Session / token store -------------------------------------------------------------------------------------
# managed: this server owns the daily login (login link, /callback, token file, optional logout).
# external: another program writes the token file; this server only reads it (never writes, deletes or logs out).
KITE_MCP_AUTH_MODE=managed
# The token file (JSON {access_token, login_date, logged_in_at, expires_at}, or a bare token). Default:
# $KITE_MCP_STATE_DIR/access_token.json
# KITE_TOKEN_FILE=
# A static token instead of the file (expiry unknown; Kite's answer decides). Usually leave unset.
# KITE_ACCESS_TOKEN=
# Refuse logins from any other Kite account (your user id, e.g. AB1234). Recommended in managed mode.
# KITE_MCP_ALLOWED_USER_ID=
# How long a login link stays usable (seconds; capped at the next 06:00 IST token reset).
KITE_MCP_LOGIN_LINK_TTL_S=3600

# --- Local state ---------------------------------------------------------------------------------------------------
# Defaults: ~/.local/state/kite-connect-mcp (token, audit log, kill switch) and ~/.cache/kite-connect-mcp (instruments)
# KITE_MCP_STATE_DIR=
# KITE_MCP_CACHE_DIR=

# --- Transport ---------------------------------------------------------------------------------------------------
# stdio for desktop clients; http (Streamable HTTP at /mcp) for a server.
KITE_MCP_TRANSPORT=stdio
KITE_MCP_HOST=127.0.0.1
KITE_MCP_PORT=8765
# Required for http: at least 32 random characters (openssl rand -hex 32). Clients send "Authorization: Bearer <it>".
# KITE_MCP_BEARER_TOKEN=
# KITE_MCP_BEARER_TOKEN_FILE=/etc/kite-connect-mcp/bearer_token
# The public https URL when behind a reverse proxy (example: https://kite.example.com). Used for Host checks.
# KITE_MCP_PUBLIC_URL=
# Extra Host header values to accept (comma-separated).
# KITE_MCP_ALLOWED_HOSTS=
# Path of the login callback; your Kite app's redirect URL must be <public url><this path>.
KITE_MCP_CALLBACK_PATH=/callback
# Enable Kite order postbacks at this path (example: /postback); the postback URL in the developer console must match.
# KITE_MCP_POSTBACK_PATH=
# Only for a throwaway loopback test: serve HTTP without a bearer token.
KITE_MCP_ALLOW_UNAUTHENTICATED_HTTP=false

# --- Safety ------------------------------------------------------------------------------------------------------
# true: every write tool is hidden and the HTTP client refuses write endpoints.
KITE_MCP_READ_ONLY=false
# dry_run: writes can only be previewed. live: writes can be sent, after confirmation and every check.
KITE_MCP_TRADING_MODE=dry_run
# token: a live write needs the confirmation_token from a dry run of the identical call.
# allowlist: writes whose every leg is in KITE_MCP_ALLOWED_INSTRUMENTS skip the token (everything else still needs it).
KITE_MCP_LIVE_CONFIRMATION=token
KITE_MCP_CONFIRMATION_TTL_S=300
# Caps on live writes (INR notional; quantity x price, or LTP / trigger based for MARKET / SL-M orders).
KITE_MCP_MAX_ORDER_VALUE=10000
KITE_MCP_MAX_DAILY_VALUE=50000
KITE_MCP_MAX_ORDERS_PER_DAY=20
# KITE_MCP_MAX_QUANTITY=
# Allow-lists (comma-separated; unset or * = any). Instruments are EXCHANGE:TRADINGSYMBOL.
# KITE_MCP_ALLOWED_INSTRUMENTS=NSE:INFY,NSE:TCS
# KITE_MCP_ALLOWED_EXCHANGES=NSE,BSE
# KITE_MCP_ALLOWED_PRODUCTS=CNC
# KITE_MCP_ALLOWED_VARIETIES=regular,amo
# KITE_MCP_ALLOWED_ORDER_TYPES=LIMIT
# KITE_MCP_ALLOWED_TRANSACTION_TYPES=BUY,SELL
# Mutual-fund order / SIP writes use legacy routes Kite no longer documents; off unless you opt in.
KITE_MCP_ALLOW_MF_WRITES=false
# When this file exists every write is refused. Default: $KITE_MCP_STATE_DIR/KILL_SWITCH
# KITE_MCP_KILL_SWITCH_FILE=

# --- Tools -------------------------------------------------------------------------------------------------------
# Toolsets to expose (comma-separated or "all"): session,account,orders,gtt,alerts,portfolio,market,margins,mf,ticker,safety
KITE_MCP_TOOLSETS=all
# Individual tools to hide (comma-separated names).
# KITE_MCP_EXCLUDED_TOOLS=

# --- WebSocket ticker ----------------------------------------------------------------------------------------------
KITE_MCP_TICKER_ENABLED=true
KITE_MCP_TICKER_MAX_SUBSCRIPTIONS=1000

# --- Misc --------------------------------------------------------------------------------------------------------
KITE_MCP_HTTP_TIMEOUT_S=30
KITE_MCP_LOG_LEVEL=INFO
